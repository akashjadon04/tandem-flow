# ==============================================================================
# Tandem Flow: Environment Configuration
# ==============================================================================

# Core n8n Instance Configuration
N8N_PORT=5678
N8N_ENCRYPTION_KEY=tandem_flow_secret_key_prod_2026
WEBHOOK_URL=http://localhost:5678/

# Redis Mutex & Distributed Lock Fabric
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_LOCK_TTL_SECONDS=30

# Integration Endpoints & Secrets
NOTION_API_KEY=secret_notion_api_token_here
NOTION_DATABASE_ID=your_notion_database_uuid_here
TODOIST_API_TOKEN=your_todoist_personal_token_here
TODOIST_PROJECT_ID=your_todoist_project_id_here

# Debounce & Sync Thresholds (Milliseconds)
DEBOUNCE_WINDOW_MS=2500
MAX_DELTA_BATCH_SIZE=50
